# ==============================================================================
# PataAI Backend Environment Configuration
# Copy this file to .env and configure values for local development.
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gemini AI API Key (required for LLM agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./pataai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/pataaidb

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache & Overpass API settings
OSM_OVERPASS_URL=http://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=5.0
